<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout style="@style/UiKit.ViewGroup.Page"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.google.android.material.appbar.AppBarLayout style="@style/AppTheme.AppBarLayout.Flat">
        <androidx.appcompat.widget.Toolbar style="@style/AppTheme.Toolbar" />
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.core.widget.NestedScrollView style="@style/UiKit.ViewGroup.NestedScrollView.AppBarScrollingViewBehavior">
        <LinearLayout style="@style/UiKit.ViewGroup.LinearLayout">
            <TextView android:id="@id/settings_text_images_display_header" android:text="@string/inline_media_label" style="@style/UiKit.Settings.Item.Header" />
            <com.discord.views.CheckedSetting android:id="@id/settings_text_images_embeds_toggle" app:cs_text="@string/inline_embed_media" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed" />
            <com.discord.views.CheckedSetting android:id="@id/attachments_toggle" app:cs_subtext="@string/inline_attachment_media_help" app:cs_text="@string/inline_attachment_media" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed" />
            <com.discord.views.CheckedSetting android:id="@id/settings_text_images_descriptions_toggle" app:cs_subtext="@string/image_description_help" app:cs_text="@string/user_settings_image_descriptions" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed" />
            <TextView android:id="@id/settings_text_images_stickers_header" android:text="@string/stickers_auto_play_heading" style="@style/UiKit.Settings.Item.Header" />
            <com.discord.views.CheckedSetting android:id="@id/settings_text_images_sticker_autocomplete_toggle" app:cs_subtext="@string/stickers_in_autocomplete_help" app:cs_text="@string/stickers_in_autocomplete" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed" />
            <com.discord.views.CheckedSetting android:id="@id/stickers_suggestions" app:cs_subtext="@string/auto_suggest_stickers_description" app:cs_text="@string/auto_suggest_stickers" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed" />
            <View style="@style/UiKit.Settings.Divider" />
            <TextView android:id="@id/settings_text_images_compression_header" android:text="@string/image_compression" style="@style/UiKit.Settings.Item.Header" />
            <com.discord.views.CheckedSetting android:id="@id/compression_toggle" app:cs_text="@string/image_compression_label" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed" />
            <com.discord.utilities.view.text.LinkifiedTextView android:id="@id/compression_toggle_subtext" android:paddingTop="4.0dip" style="@style/UiKit.Settings.Item.SubText" />
            <View style="@style/UiKit.Settings.Divider" />
            <TextView android:id="@id/settings_text_images_preview_header" android:text="@string/render_embeds_label" style="@style/UiKit.Settings.Item.Header" />
            <com.discord.views.CheckedSetting android:id="@id/settings_text_images_links_toggle" app:cs_text="@string/render_embeds" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed" />
            <View style="@style/UiKit.Settings.Divider" />
            <TextView android:id="@id/settings_text_images_emoji_header" android:text="@string/emoji_settings_header" style="@style/UiKit.Settings.Item.Header" />
            <com.discord.views.CheckedSetting android:id="@id/settings_text_images_reactions_toggle" app:cs_text="@string/render_reactions" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed" />
            <com.discord.views.CheckedSetting android:id="@id/settings_text_images_emoticons_toggle" app:cs_subtext="@string/convert_emoticons_help" app:cs_text="@string/convert_emoticons" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed" />
            <TextView android:id="@id/settings_text_images_swipe_header" android:text="@string/swipe_right_to_left" style="@style/UiKit.Settings.Item.Header" />
            <com.discord.views.CheckedSetting android:id="@id/settings_text_images_swipe_channel_details" app:cs_subtext="@string/swipe_right_to_left_channel_details_description" app:cs_text="@string/swipe_right_to_left_channel_details" app:cs_view_type="radio" style="@style/UiKit.CheckedSetting.Themed" />
            <com.discord.views.CheckedSetting android:id="@id/settings_text_images_swipe_reply" app:cs_text="@string/swipe_right_to_left_reply" app:cs_view_type="radio" style="@style/UiKit.CheckedSetting.Themed" />
            <View style="@style/UiKit.Settings.Divider" />
            <TextView android:id="@id/settings_text_images_sync_header" android:text="@string/sync" style="@style/UiKit.Settings.Item.Header" />
            <com.discord.views.CheckedSetting android:id="@id/settings_text_images_sync_toggle" app:cs_text="@string/settings_sync" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed" />
            <View style="@style/UiKit.Settings.Divider" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>