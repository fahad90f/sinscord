<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:id="@id/system_channel_wrap" style="@style/UiKit.ViewGroup.LinearLayout"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <TextView android:text="@string/form_label_system_channel" style="@style/UiKit.Settings.Item.Label" />
    <TextView android:id="@id/system_channel" android:drawablePadding="2.0dip" style="@style/UiKit.Settings.Item.Addition" />
    <TextView android:text="@string/form_help_system_channel" style="@style/UiKit.Settings.Item.SubText.Attached" />
    <com.discord.views.CheckedSetting android:id="@id/system_channel_join" app:cs_text="@string/form_help_system_channel_join_messages" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed" />
    <com.discord.views.CheckedSetting android:id="@id/system_channel_join_replies" app:cs_text="@string/form_help_system_channel_join_message_replies" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed" />
    <com.discord.views.CheckedSetting android:id="@id/system_channel_boost" app:cs_text="@string/form_help_system_channel_premium_subscription_messages" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed" />
    <com.discord.views.CheckedSetting android:id="@id/system_channel_guild_reminders" app:cs_text="@string/form_help_system_channel_guild_reminders" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed" />
    <com.discord.views.CheckedSetting android:id="@id/system_channel_role_subscription_purchase" android:visibility="gone" app:cs_text="@string/form_help_system_channel_role_subscription_purchase_messages" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed" />
    <com.discord.views.CheckedSetting android:id="@id/system_channel_role_subscription_purchase_replies" android:visibility="gone" app:cs_text="@string/form_help_system_channel_role_subscription_purchase_message_replies" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed" />
    <com.discord.views.CheckedSetting android:id="@id/system_channel_voice_hangout" app:cs_text="@string/form_help_system_channel_voice_hangout_messages" app:cs_view_type="switchview" style="@style/UiKit.CheckedSetting.Themed" />
</LinearLayout>